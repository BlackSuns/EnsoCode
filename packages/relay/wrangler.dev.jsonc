{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 开发用副本：独立脚本名、DO 命名空间与自定义域，不影响生产环境。
  // 桌面端「设置 → 设备 → 中继地址」填 https://enso-relay-dev.j3.do 即可整链路联调。
  "name": "enso-pair-relay-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": false },
  "routes": [{ "pattern": "enso-relay-dev.j3.do", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PAIR_ROOM", "class_name": "PairRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairRoom"] }],
  "assets": {
    "directory": "../phone/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  }
}
